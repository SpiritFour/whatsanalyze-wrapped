# Production Environment Variables
# Copy this to .env.prod and fill in your production values

# Public Stripe Key (Live Mode)
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Price IDs (Live Mode)
BASIC_PRICE_ID=price_live_...
PRO_PRICE_ID=price_live_...

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=https://wrapped.whatsanalyze.com/

# Base Url used in Email Templates
EMAIL_BASE_URL=https://wrapped.whatsanalyze.com

# Note: Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) should be set via:
# firebase --project prod functions:secrets:set STRIPE_SECRET_KEY
# firebase --project prod functions:secrets:set STRIPE_WEBHOOK_SECRET
